{
  "$schema": "./tokens.schema.json",
  "meta": {
    "name": "Anchor Design System",
    "version": "0.1.0",
    "basedOn": "shadcn/ui (via Beat DS 2)",
    "colorSpace": "hsl + oklch (status)",
    "description": "Single source of truth for Anchor DS tokens. Mirrors Beat 2 (which is shadcn-based). Values below drive tokens.css and the planned WPF ResourceDictionary.",
    "themes": ["light", "dark"],
    "primaryTheme": "dark"
  },
  "tokens": {
    "surface": {
      "background":         { "light": "hsl(0 0% 100%)",       "dark": "hsl(231 52% 5%)",  "wpf": "DS.Brush.Background" },
      "foreground":         { "light": "hsl(218 23% 23%)",    "dark": "hsl(0 0% 95%)",    "wpf": "DS.Brush.Foreground" },
      "card":               { "light": "hsl(0 0% 100%)",      "dark": "hsl(231 44% 8%)",  "wpf": "DS.Brush.Card" },
      "card-foreground":    { "light": "hsl(231 40% 10%)",    "dark": "hsl(0 0% 95%)",    "wpf": "DS.Brush.Card.Foreground" },
      "popover":            { "light": "hsl(0 0% 100%)",      "dark": "hsl(231 44% 8%)",  "wpf": "DS.Brush.Popover" },
      "popover-foreground": { "light": "hsl(231 40% 10%)",    "dark": "hsl(0 0% 95%)",    "wpf": "DS.Brush.Popover.Foreground" }
    },
    "brand": {
      "primary":              { "light": "hsl(32 100% 49%)",   "dark": "hsl(32 100% 49%)", "wpf": "DS.Brush.Primary" },
      "primary-foreground":   { "light": "hsl(0 0% 100%)",     "dark": "hsl(0 0% 100%)",   "wpf": "DS.Brush.Primary.Foreground" },
      "secondary":            { "light": "hsl(210 38% 95%)",   "dark": "hsl(0 0% 15%)",    "wpf": "DS.Brush.Secondary" },
      "secondary-foreground": { "light": "hsl(218 23% 23%)",   "dark": "hsl(0 0% 95%)",    "wpf": "DS.Brush.Secondary.Foreground" },
      "accent":               { "light": "hsl(32 100% 49%)",   "dark": "hsl(32 100% 49%)", "wpf": "DS.Brush.Accent" },
      "accent-foreground":    { "light": "hsl(0 0% 100%)",     "dark": "hsl(0 0% 100%)",   "wpf": "DS.Brush.Accent.Foreground" }
    },
    "neutral": {
      "muted":            { "light": "hsl(204 50% 98%)", "dark": "hsl(0 0% 13%)", "wpf": "DS.Brush.Muted" },
      "muted-foreground": { "light": "hsl(216 15% 51%)", "dark": "hsl(0 0% 65%)", "wpf": "DS.Brush.Muted.Foreground" },
      "modal-bg":         { "light": "hsl(0 0% 100%)", "dark": "hsl(0 0% 0%)", "wpf": "DS.Brush.Modal.Background" },
      "surface-tile":     { "light": "hsl(204 50% 98%)", "dark": "hsl(0 0% 8%)", "wpf": "DS.Brush.Surface.Tile" },
      "table-row-selected": { "light": "hsl(201 90% 92%)", "dark": "hsl(214 33% 14%)", "wpf": "DS.Brush.Table.RowSelected" }
    },
    "feedback": {
      "destructive":            { "light": "hsl(0 75% 56%)", "dark": "hsl(0 74% 55%)", "wpf": "DS.Brush.Destructive" },
      "destructive-foreground": { "light": "hsl(0 0% 100%)",   "dark": "hsl(0 0% 100%)",   "wpf": "DS.Brush.Destructive.Foreground" }
    },
    "form": {
      "border":       { "light": "hsl(214 31% 91%)", "dark": "hsl(0 0% 18%)", "wpf": "DS.Brush.Border" },
      "input":        { "light": "hsl(204 50% 98%)", "dark": "hsl(0 0% 12%)", "wpf": "DS.Brush.Input" },
      "input-border": { "light": "hsl(214 31% 91%)", "dark": "hsl(0 0% 30%)", "wpf": "DS.Brush.Input.Border" },
      "ring":         { "light": "hsl(32 100% 49%)", "dark": "hsl(32 100% 49%)", "wpf": "DS.Brush.Ring" }
    },
    "status": {
      "info":        { "dot": "oklch(68.5% .169 237.323)", "bg": "oklch(68.5% .169 237.323 / .15)", "fg": "oklch(82.8% .111 230.318)", "wpf": "DS.Brush.Status.Info" },
      "success":     { "dot": "oklch(69.6% .17 162.48)",   "bg": "oklch(69.6% .17 162.48 / .15)",   "fg": "oklch(84.5% .143 164.978)", "wpf": "DS.Brush.Status.Success" },
      "warning":     { "dot": "oklch(76.9% .188 70.08)",   "bg": "oklch(76.9% .188 70.08 / .15)",   "fg": "oklch(87.9% .169 91.605)", "wpf": "DS.Brush.Status.Warning" },
      "destructive": { "dot": "oklch(63.7% .237 25.331)",  "bg": "oklch(63.7% .237 25.331 / .15)",  "fg": "oklch(80.8% .114 19.571)", "wpf": "DS.Brush.Status.Destructive" },
      "neutral":     { "dot": "oklch(70.4% .04 256.788)",  "bg": "oklch(55.4% .046 257.417 / .15)", "fg": "oklch(86.9% .022 252.894)", "wpf": "DS.Brush.Status.Neutral" }
    },
    "alert": {
      "info-bg":             { "light": "#bee3f8", "dark": "#bee3f8", "wpf": "DS.Brush.Alert.Info.Background" },
      "success-bg":          { "light": "#c6f6d5", "dark": "#c6f6d5", "wpf": "DS.Brush.Alert.Success.Background" },
      "warning-bg":          { "light": "#ffe7cc", "dark": "#ffe7cc", "wpf": "DS.Brush.Alert.Warning.Background" },
      "destructive-bg":      { "light": "#fed7d7", "dark": "#fed7d7", "wpf": "DS.Brush.Alert.Destructive.Background" },
      "destructive-solid-bg":{ "light": "#f56565", "dark": "#f56565", "wpf": "DS.Brush.Alert.Destructive.Solid.Background" },
      "foreground":          { "light": "#2d3748", "dark": "#2d3748", "wpf": "DS.Brush.Alert.Foreground" }
    },
    "radius": {
      "sm":    { "value": "4px",    "wpf": "DS.Radius.Sm" },
      "md":    { "value": "8px",    "wpf": "DS.Radius.Md" },
      "lg":    { "value": "12px",   "wpf": "DS.Radius.Lg" },
      "badge": { "value": "6px",    "wpf": "DS.Radius.Badge" },
      "full":  { "value": "9999px", "wpf": "DS.Radius.Full" }
    },
    "spacing": {
      "xs":  { "value": "4px",  "wpf": "DS.Space.Xs" },
      "sm":  { "value": "8px",  "wpf": "DS.Space.Sm" },
      "md":  { "value": "12px", "wpf": "DS.Space.Md" },
      "lg":  { "value": "16px", "wpf": "DS.Space.Lg" },
      "xl":  { "value": "20px", "wpf": "DS.Space.Xl" },
      "2xl": { "value": "24px", "wpf": "DS.Space.2xl" },
      "3xl": { "value": "32px", "wpf": "DS.Space.3xl" },
      "4xl": { "value": "40px", "wpf": "DS.Space.4xl" }
    },
    "typography": {
      "font-sans": { "value": "Inter, 'Segoe UI Variable', 'Segoe UI', system-ui, sans-serif", "wpf": "DS.Font.Sans" },
      "font-mono": { "value": "ui-monospace, Menlo, Consolas, monospace", "wpf": "DS.Font.Mono" },
      "scale": {
        "display": { "size": "40px", "weight": 600, "tracking": "-0.02em" },
        "h1":      { "size": "28px", "weight": 600 },
        "h2":      { "size": "22px", "weight": 600 },
        "h3":      { "size": "18px", "weight": 600 },
        "body":    { "size": "14px", "weight": 400 },
        "body-sm": { "size": "13px", "weight": 400 },
        "caption": { "size": "11px", "weight": 500, "tracking": "0.04em", "case": "uppercase" },
        "code":    { "size": "13px", "weight": 400, "family": "mono" }
      }
    },
    "elevation": {
      "sm": { "light": "0 1px 2px rgba(20,24,40,.08)",  "dark": "0 1px 2px rgba(0,0,0,.4)",  "wpf": "DS.Shadow.Sm" },
      "md": { "light": "0 4px 12px rgba(20,24,40,.08)", "dark": "0 4px 12px rgba(0,0,0,.4)", "wpf": "DS.Shadow.Md" },
      "lg": { "light": "0 12px 32px rgba(20,24,40,.12)","dark": "0 12px 32px rgba(0,0,0,.5)","wpf": "DS.Shadow.Lg" }
    }
  }
}
